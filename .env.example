# ==============================================================================
# UdaLink — Environment Variables
# ==============================================================================
# Salin file ini menjadi .env.local dan isi nilainya.
# JANGAN commit .env.local ke Git!
# ==============================================================================

# --- Supabase (WAJIB) --------------------------------------------------------
# Dapatkan dari: Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# --- URL Aplikasi (WAJIB untuk produksi) -------------------------------------
# Lokal: http://localhost:3000
# Produksi: https://udalink.vercel.app (sesuaikan dengan domain kamu)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Konfigurasi Auth Email (opsional, untuk redirect setelah konfirmasi) ----
# Pastikan URL ini didaftarkan di: Supabase → Auth → URL Configuration
# Redirect URLs:
#   http://localhost:3000/**
#   https://your-domain.vercel.app/**
